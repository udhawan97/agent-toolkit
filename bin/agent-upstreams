#!/usr/bin/env python3
"""Install and verify allowlisted upstream tools without vendoring their code."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import platform
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
import zipfile
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
CATALOG_PATH = ROOT / "catalog" / "upstreams.json"
STATE_DIR = Path.home() / ".agent-toolkit"
STATE_FILE = STATE_DIR / "upstreams.json"
GRAPHIFY_RUNTIME_BEGIN = "<!-- agent-toolkit-graphify-runtime:begin -->"
GRAPHIFY_RUNTIME_END = "<!-- agent-toolkit-graphify-runtime:end -->"


class UpstreamError(RuntimeError):
    pass


def client_config_root(client: str) -> Path:
    variable = "CODEX_HOME" if client == "codex" else "CLAUDE_CONFIG_DIR"
    default = Path.home() / (".codex" if client == "codex" else ".claude")
    raw = os.environ.get(variable)
    if raw is not None and not raw.strip():
        raise UpstreamError(f"{variable} must not be empty")
    path = Path(raw).expanduser() if raw is not None else default
    if not path.is_absolute():
        raise UpstreamError(f"{variable} must be an absolute directory: {path}")
    path = Path(os.path.abspath(path))
    if path == Path(path.anchor):
        raise UpstreamError(f"{variable} must not be a filesystem root: {path}")
    return path


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise UpstreamError(f"Cannot read valid JSON from {path}: {exc}") from exc


def run(
    command: list[str],
    *,
    dry_run: bool = False,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess[str] | None:
    print("+ " + " ".join(command))
    if dry_run:
        return None
    completed = subprocess.run(command, check=False, text=True, capture_output=capture)
    if check and completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "unknown error").strip()
        raise UpstreamError(f"Command failed ({completed.returncode}): {' '.join(command)}\n{detail}")
    return completed


def run_json(command: list[str]) -> Any:
    completed = run(command, capture=True)
    assert completed is not None
    try:
        return json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise UpstreamError(f"Command did not return JSON: {' '.join(command)}") from exc


def ensure_private_directory(path: Path) -> None:
    for candidate in (path, *path.parents):
        if candidate.is_symlink():
            raise UpstreamError(f"Refusing to use toolkit state through a symlink: {candidate}")
        if candidate == Path.home():
            break
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    if os.name != "nt":
        os.chmod(path, 0o700)


def save_receipt(
    profile: str,
    clients: list[str],
    bundles: list[str],
    resolved: dict[str, dict[str, Any]],
) -> None:
    ensure_private_directory(STATE_DIR)
    if STATE_FILE.is_symlink():
        raise UpstreamError(f"Refusing symlinked upstream receipt: {STATE_FILE}")
    previous = load_receipt()
    previous_clients = previous.get("clients", []) if previous else []
    previous_bundles = previous.get("bundles", []) if previous else []
    previous_resolved = previous.get("resolved", {}) if previous else {}
    merged_clients = list(
        dict.fromkeys(
            [item for item in previous_clients if item in {"codex", "claude"}] + clients
        )
    )
    merged_bundles = list(
        dict.fromkeys(
            [item for item in previous_bundles if isinstance(item, str)] + bundles
        )
    )
    merged_resolved = dict(previous_resolved) if isinstance(previous_resolved, dict) else {}
    merged_resolved.update(resolved)
    payload = {
        "schemaVersion": 2,
        "profile": profile,
        "clients": merged_clients,
        "bundles": merged_bundles,
        "resolved": merged_resolved,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "note": "Upstream packages remain owned and maintained by their source providers.",
    }
    descriptor, temporary_name = tempfile.mkstemp(
        dir=STATE_DIR, prefix=".upstreams-", suffix=".tmp"
    )
    temporary = Path(temporary_name)
    try:
        if os.name != "nt":
            os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = -1
            handle.write(json.dumps(payload, indent=2, sort_keys=True) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        if temporary.is_symlink() or not temporary.is_file():
            raise UpstreamError(f"Refusing unsafe upstream receipt temporary: {temporary}")
        os.replace(temporary, STATE_FILE)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary.exists() or temporary.is_symlink():
            temporary.unlink()


def load_receipt() -> dict[str, Any] | None:
    if not STATE_FILE.exists():
        return None
    if STATE_FILE.is_symlink():
        raise UpstreamError(f"Refusing symlinked upstream receipt: {STATE_FILE}")
    data = load_json(STATE_FILE)
    if not isinstance(data, dict) or data.get("schemaVersion") not in {1, 2}:
        raise UpstreamError("Unsupported upstream receipt schema")
    return data


def selected_clients(raw: str) -> list[str]:
    clients = [item for item in raw.split(",") if item]
    if not clients or any(item not in {"codex", "claude"} for item in clients):
        raise UpstreamError("--clients must be a comma-separated subset of codex,claude")
    missing = [item for item in clients if not shutil.which(item)]
    if missing:
        raise UpstreamError("Requested client is not available on PATH: " + ", ".join(missing))
    for client in clients:
        client_config_root(client)
    return clients


def profile_bundles(profile: str) -> list[str]:
    data = load_json(ROOT / "profiles" / f"{profile}.json")
    bundles = data.get("upstreams") if isinstance(data, dict) else None
    if not isinstance(bundles, list) or not all(isinstance(item, str) for item in bundles):
        raise UpstreamError(f"Profile has an invalid upstreams list: {profile}")
    return bundles


def catalog_bundles() -> dict[str, dict[str, Any]]:
    data = load_json(CATALOG_PATH)
    bundles = data.get("bundles") if isinstance(data, dict) else None
    if data.get("schemaVersion") != 1 or not isinstance(bundles, dict):
        raise UpstreamError("Unsupported upstream catalog schema")
    return bundles


def clients_for(bundle: dict[str, Any], clients: list[str]) -> list[str]:
    supported = bundle.get("clients", [])
    return [client for client in clients if client in supported]


def normalize_repo(value: str) -> str | None:
    candidate = value.strip().rstrip("/")
    match = re.fullmatch(
        r"(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)?"
        r"(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+?)(?:\.git)?",
        candidate,
        re.IGNORECASE,
    )
    return f"{match.group('owner')}/{match.group('repo')}".lower() if match else None


def graphify_environment(bundle: dict[str, Any]) -> Path:
    return STATE_DIR / "tools" / "graphify" / bundle["version"]


def graphify_environment_python(bundle: dict[str, Any]) -> Path:
    root = graphify_environment(bundle)
    return root / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def graphify_environment_executable(bundle: dict[str, Any]) -> Path:
    root = graphify_environment(bundle)
    return root / ("Scripts/graphify.exe" if os.name == "nt" else "bin/graphify")


def graphify_command(bundle: dict[str, Any]) -> list[str]:
    executable = graphify_environment_executable(bundle)
    unsafe = False
    for candidate in (executable, *executable.parents):
        unsafe = unsafe or candidate.is_symlink()
        if candidate == STATE_DIR:
            break
    if unsafe or not executable.is_file():
        raise UpstreamError(
            f"Graphify is missing from its toolkit-managed environment: {executable}"
        )
    return [str(executable)]


def graphify_destination_roots(clients: list[str]) -> list[tuple[Path, Path]]:
    destinations: dict[str, tuple[Path, Path]] = {}
    for client in clients:
        default_root = Path.home() / (".codex" if client == "codex" else ".claude")
        configured_root = client_config_root(client)
        for root in (default_root, configured_root):
            destination = Path(os.path.abspath(root / "skills" / "graphify"))
            boundary = Path(os.path.abspath(root))
            destinations[str(destination)] = (destination, boundary)
    return list(destinations.values())


def previous_graphify_targets(
    receipt: dict[str, Any] | None, clients: list[str]
) -> set[str]:
    if not receipt or "graphify" not in receipt.get("bundles", []):
        return set()
    if receipt.get("schemaVersion") == 2:
        resolved = receipt.get("resolved", {}).get("graphify", {})
        targets = resolved.get("targets") if isinstance(resolved, dict) else None
        return {
            str(Path(os.path.abspath(path)))
            for path in targets or []
            if isinstance(path, str)
        }
    prior_clients = [
        client for client in receipt.get("clients", []) if client in {"codex", "claude"}
    ]
    return {str(path) for path, _ in graphify_destination_roots(prior_clients)}


def preflight_graphify_destinations(
    destinations: list[tuple[Path, Path]],
    owned: set[str],
    *,
    adopt_existing: bool,
    dry_run: bool,
) -> None:
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    backup_root = STATE_DIR / "backups" / "graphify" / stamp
    for index, (destination, boundary) in enumerate(destinations, start=1):
        validate_skill_destination(destination, boundary)
        if not destination.exists():
            continue
        if not destination.is_dir():
            raise UpstreamError(f"Refusing non-directory Graphify destination: {destination}")
        skill_tree_manifest(destination)
        if str(destination) in owned:
            continue
        if not adopt_existing:
            raise UpstreamError(
                f"Refusing unmanaged Graphify skill at {destination}. "
                "Re-run with --adopt-existing to preserve and explicitly replace it."
            )
        backup = backup_root / f"target-{index}" / "graphify"
        print(f"+ preserve existing Graphify skill before adoption: {destination} -> {backup}")
        if dry_run:
            continue
        backup.parent.mkdir(parents=True, exist_ok=True)
        if backup.exists() or backup.is_symlink():
            raise UpstreamError(f"Refusing existing Graphify backup: {backup}")
        shutil.move(str(destination), str(backup))


def install_graphify(
    bundle: dict[str, Any],
    clients: list[str],
    dry_run: bool,
    receipt: dict[str, Any] | None,
    *,
    adopt_existing: bool,
    profile: str,
) -> dict[str, Any]:
    selected = clients_for(bundle, clients)
    prior_clients = [
        client
        for client in (receipt or {}).get("clients", [])
        if client in bundle.get("clients", [])
    ]
    managed_clients = list(dict.fromkeys(selected + prior_clients))
    destinations = graphify_destination_roots(managed_clients)
    preflight_graphify_destinations(
        destinations,
        previous_graphify_targets(receipt, managed_clients),
        adopt_existing=adopt_existing,
        dry_run=dry_run,
    )
    package = f"{bundle['package']}=={bundle['version']}"
    environment = graphify_environment(bundle)
    if environment.is_symlink():
        raise UpstreamError(f"Refusing symlinked Graphify environment: {environment}")
    environment_python = graphify_environment_python(bundle)
    if not dry_run:
        ensure_private_directory(environment.parent)
        save_receipt(
            profile,
            managed_clients,
            ["graphify"],
            {
                "graphify": {
                    "package": bundle["package"],
                    "version": bundle["version"],
                    "environment": str(environment),
                    "targets": [str(path) for path, _ in destinations],
                    "status": "pending",
                }
            },
        )
    if not environment_python.is_file():
        run([sys.executable, "-m", "venv", str(environment)], dry_run=dry_run)
    run(
        [
            str(environment_python),
            "-m",
            "pip",
            "install",
            "--disable-pip-version-check",
            "--upgrade",
            package,
        ],
        dry_run=dry_run,
    )
    command = graphify_command(bundle) if not dry_run else ["graphify"]
    for client in managed_clients:
        run([*command, "install", "--platform", client], dry_run=dry_run)
        if not dry_run:
            default = Path.home() / f".{client if client == 'codex' else 'claude'}" / "skills" / "graphify"
            configured = client_config_root(client) / "skills" / "graphify"
            created = configured if (configured / "SKILL.md").is_file() else default
            created_boundary = client_config_root(client) if created == configured else default.parent.parent
            pin_graphify_discovery(created, Path(command[0]), created_boundary)
            if created != configured:
                sync_graphify_discovery(client)
            pin_graphify_discovery(
                configured, Path(command[0]), client_config_root(client)
            )
    return {
        "package": bundle["package"],
        "version": bundle["version"],
        "environment": str(environment),
        "targets": [str(path) for path, _ in destinations if path.is_dir()],
        "status": "active",
    }


def sync_graphify_discovery(client: str) -> None:
    defaults = {
        "codex": Path.home() / ".codex" / "skills" / "graphify",
        "claude": Path.home() / ".claude" / "skills" / "graphify",
    }
    configured = {
        "codex": client_config_root("codex") / "skills" / "graphify",
        "claude": client_config_root("claude") / "skills" / "graphify",
    }
    source = defaults[client]
    target = configured[client]
    validate_skill_destination(source, defaults[client].parent.parent)
    validate_skill_destination(target, client_config_root(client))
    if target == source:
        return
    source_marker = source / ".graphify_version"
    target_marker = target / ".graphify_version"
    if target.exists() and not target_marker.is_file():
        raise UpstreamError(f"Refusing to overwrite an unmanaged Graphify skill at {target}")
    if target_marker.is_file() and not source_marker.is_file():
        return
    if target_marker.is_file() and source_marker.is_file():
        if target_marker.read_text(encoding="utf-8") == source_marker.read_text(encoding="utf-8"):
            return
    if not (source / "SKILL.md").is_file() or not source_marker.is_file():
        raise UpstreamError(f"Graphify did not create its expected {client} discovery package")
    print(f"+ mirror Graphify discovery package into configured {client} home: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, target, dirs_exist_ok=True)


def pin_graphify_discovery(skill: Path, executable: Path, trusted_root: Path) -> None:
    validate_skill_destination(skill, trusted_root)
    skill_tree_manifest(skill)
    skill_file = skill / "SKILL.md"
    marker = skill / ".agent-toolkit-command"
    if not skill_file.is_file():
        raise UpstreamError(f"Graphify did not create its expected discovery package: {skill}")
    command = str(executable.resolve())
    text = skill_file.read_text(encoding="utf-8")
    pattern = re.compile(
        rf"\n?{re.escape(GRAPHIFY_RUNTIME_BEGIN)}.*?{re.escape(GRAPHIFY_RUNTIME_END)}\n?",
        re.DOTALL,
    )
    text = pattern.sub("\n", text)
    section = (
        f"{GRAPHIFY_RUNTIME_BEGIN}\n"
        "## Agent Toolkit managed runtime\n\n"
        "Use the exact managed executable below for every command in this skill. "
        "When an example says `graphify`, substitute this absolute command; do not install another copy.\n\n"
        f"```text\n{command}\n```\n"
        f"{GRAPHIFY_RUNTIME_END}\n\n"
    )
    frontmatter_end = text.find("\n---\n", 4) if text.startswith("---\n") else -1
    insertion = frontmatter_end + len("\n---\n") if frontmatter_end >= 0 else 0
    updated = text[:insertion] + "\n" + section + text[insertion:].lstrip("\n")
    skill_file.write_text(updated, encoding="utf-8")
    marker.write_text(command + "\n", encoding="utf-8")


def graphify_discovery_problem(skill: Path, executable: Path) -> str | None:
    skill_file = skill / "SKILL.md"
    marker = skill / ".agent-toolkit-command"
    if not skill_file.is_file() or not marker.is_file():
        return "managed discovery package or command marker is missing"
    expected = str(executable.resolve())
    try:
        recorded = marker.read_text(encoding="utf-8").strip()
        text = skill_file.read_text(encoding="utf-8")
    except OSError as exc:
        return str(exc)
    if recorded != expected or expected not in text:
        return "managed executable is not pinned in the discovery instructions"
    if GRAPHIFY_RUNTIME_BEGIN not in text or GRAPHIFY_RUNTIME_END not in text:
        return "managed runtime instructions are missing"
    return None


def doctor_graphify(
    bundle: dict[str, Any], clients: list[str], receipt: dict[str, Any] | None
) -> int:
    resolved = (receipt or {}).get("resolved", {}).get("graphify")
    if not isinstance(resolved, dict):
        print("FAIL upstream Graphify: install receipt is outdated; run update")
        return 1
    if resolved.get("status") == "pending":
        print("FAIL upstream Graphify: interrupted refresh is pending; run update")
        return 1
    targets = resolved.get("targets")
    if not isinstance(targets, list) or not all(isinstance(path, str) for path in targets):
        print("FAIL upstream Graphify: receipt has no valid managed targets")
        return 1
    required_targets = {
        str(client_config_root(client) / "skills" / "graphify")
        for client in clients_for(bundle, clients)
    }
    if not required_targets.issubset(set(targets)):
        print("FAIL upstream Graphify: selected client target is not receipted")
        return 1
    try:
        command = graphify_command(bundle)
        version = run([*command, "--version"], capture=True)
        assert version is not None
        observed = (version.stdout or version.stderr).strip()
        if bundle["version"] not in observed:
            raise UpstreamError(f"expected {bundle['version']}, found {observed or 'unknown version'}")
        print(f"PASS upstream Graphify: {observed}")
    except UpstreamError as exc:
        print(f"FAIL upstream Graphify: {exc}")
        return 1
    failures = 0
    homes = {
        "codex": client_config_root("codex") / "skills" / "graphify",
        "claude": client_config_root("claude") / "skills" / "graphify",
    }
    executable = Path(command[0])
    for client in clients_for(bundle, clients):
        problem = graphify_discovery_problem(homes[client], executable)
        healthy = problem is None
        detail = "managed command pinned" if healthy else problem
        print(f"{'PASS' if healthy else 'FAIL'} upstream Graphify discovery: {client} ({detail})")
        failures += 0 if healthy else 1
    return failures


def git_value(path: Path, *arguments: str) -> str:
    completed = subprocess.run(
        ["git", "-C", str(path), *arguments], check=False, text=True, capture_output=True
    )
    if completed.returncode != 0:
        return ""
    return completed.stdout.strip()


def checkout_problem(
    path: Path,
    repository: str,
    *,
    expected_commit: str | None = None,
    tracking_ref: str | None = None,
) -> str | None:
    if path.is_symlink() or not path.is_dir() or not git_checkout_matches(path, repository):
        return "checkout is missing or has an unexpected origin"
    if git_value(path, "status", "--porcelain"):
        return "checkout has local modifications"
    head = git_value(path, "rev-parse", "HEAD")
    if expected_commit and head != expected_commit:
        return f"HEAD {head or 'unknown'} does not match exact commit {expected_commit}"
    if tracking_ref:
        tracked = git_value(path, "rev-parse", f"refs/remotes/origin/{tracking_ref}")
        if not tracked or head != tracked:
            return f"HEAD does not exactly match refs/remotes/origin/{tracking_ref}"
    return None


def ensure_tracked_skills_checkout(
    bundle: dict[str, Any],
    dry_run: bool,
    *,
    bundle_name: str = "matt-pocock-skills",
) -> Path:
    display_name = bundle.get("displayName", bundle_name)
    git = shutil.which("git")
    if not git:
        raise UpstreamError(f"{display_name} requires Git on PATH.")
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", bundle_name):
        raise UpstreamError(f"Unsafe skills bundle name: {bundle_name}")
    checkout = STATE_DIR / "sources" / bundle_name
    repository = bundle["repository"]
    ref = bundle.get("ref", "main")
    if checkout.is_symlink():
        raise UpstreamError(f"Refusing symlinked {display_name} source: {checkout}")
    if not checkout.exists():
        if not dry_run:
            ensure_private_directory(checkout.parent)
        run(
            [
                git,
                "clone",
                "--depth",
                "1",
                "--branch",
                ref,
                f"https://github.com/{repository}.git",
                str(checkout),
            ],
            dry_run=dry_run,
        )
    elif not git_checkout_matches(checkout, repository):
        raise UpstreamError(f"Refusing unexpected {display_name} source at {checkout}")
    if dry_run:
        print(f"+ fetch the current {display_name} source from origin/{ref}")
        return checkout
    if git_value(checkout, "status", "--porcelain"):
        raise UpstreamError(f"Refusing modified {display_name} checkout: {checkout}")
    run([git, "-C", str(checkout), "fetch", "--prune", "origin", ref])
    run([git, "-C", str(checkout), "checkout", "--detach", "FETCH_HEAD"])
    head = git_value(checkout, "rev-parse", "HEAD")
    fetched = git_value(checkout, "rev-parse", "FETCH_HEAD")
    problem = checkout_problem(checkout, repository, expected_commit=fetched)
    if problem:
        raise UpstreamError(f"{display_name} source verification failed: {problem}")
    if not head or head != fetched:
        raise UpstreamError(f"{display_name} source does not exactly match the fetched commit")
    return checkout


def discover_skill_package(
    checkout: Path,
    bundle: dict[str, Any],
    *,
    bundle_name: str = "matt-pocock-skills",
) -> dict[str, str]:
    display_name = bundle.get("displayName", bundle_name)
    root = checkout / bundle.get("skillRoot", "skills")
    if root.is_symlink() or not root.is_dir():
        raise UpstreamError(f"{display_name} skills root is missing or unsafe: {root}")
    discovered: dict[str, str] = {}
    allowlist = bundle.get("skills")
    if allowlist is None:
        candidates = [
            (skill_file.parent.name, skill_file.parent)
            for skill_file in sorted(root.rglob("SKILL.md"))
        ]
    else:
        if not isinstance(allowlist, dict) or not allowlist:
            raise UpstreamError(f"{display_name} has an invalid skill allowlist")
        candidates = []
        for name, relative in sorted(allowlist.items()):
            if (
                not isinstance(relative, str)
                or not relative
                or Path(relative).is_absolute()
                or ".." in Path(relative).parts
            ):
                raise UpstreamError(f"{display_name} has an unsafe skill path for {name}")
            source = checkout / relative
            try:
                source.resolve().relative_to(checkout.resolve())
            except ValueError as exc:
                raise UpstreamError(f"{display_name} skill escapes its checkout: {name}") from exc
            if not (source / "SKILL.md").is_file():
                raise UpstreamError(f"{display_name} allowlisted skill is missing: {name}")
            candidates.append((name, source))
    for name, source in candidates:
        for candidate in (source, *source.parents):
            if candidate.is_symlink():
                raise UpstreamError(f"{display_name} skill path traverses a symlink: {candidate}")
            if candidate in {root, checkout}:
                break
        if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name):
            raise UpstreamError(f"{display_name} skill has an unsafe name: {name}")
        if name in discovered:
            raise UpstreamError(f"{display_name} skill name is duplicated: {name}")
        skill_tree_manifest(source)
        discovered[name] = source.relative_to(checkout).as_posix()
    if not discovered:
        raise UpstreamError(f"No {display_name} skills were found in the fetched source")
    return discovered


def validate_skill_destination(destination: Path, trusted_root: Path) -> None:
    """Reject symlinks inside the client-owned destination boundary."""
    reached_root = False
    for candidate in (destination, *destination.parents):
        if candidate.is_symlink():
            raise UpstreamError(f"Refusing symlinked skill destination path: {candidate}")
        if candidate == trusted_root:
            reached_root = True
            break
    if not reached_root:
        raise UpstreamError(
            f"Skill destination is outside its configured client root: {destination}"
        )


def backup_and_copy_skill(
    source: Path,
    destination: Path,
    backup_root: Path,
    trusted_root: Path,
    *,
    managed: bool,
    adopt_existing: bool,
) -> None:
    validate_skill_destination(destination, trusted_root)
    if destination.exists():
        if not destination.is_dir():
            raise UpstreamError(f"Refusing non-directory skill destination: {destination}")
        if not managed and not adopt_existing:
            raise UpstreamError(
                f"Refusing unmanaged skill at {destination}. "
                "Re-run with --adopt-existing to preserve and explicitly replace it."
            )
        if skill_tree_problem(source, destination) is None:
            return
        backup = backup_root / destination.name
        backup.parent.mkdir(parents=True, exist_ok=True)
        if backup.exists() or backup.is_symlink():
            raise UpstreamError(f"Refusing existing skill backup: {backup}")
        print(f"+ preserve existing skill before refresh: {destination} -> {backup}")
        shutil.move(str(destination), str(backup))
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(
        dir=destination.parent, prefix=f".agent-toolkit-{destination.name}-"
    ) as temporary:
        staged = Path(temporary) / destination.name
        shutil.copytree(source, staged)
        skill_tree_manifest(staged)
        os.replace(staged, destination)


def skill_destination_roots(selected: list[str]) -> list[tuple[Path, Path]]:
    roots = [(Path.home() / ".agents" / "skills", Path.home() / ".agents")]
    if "claude" in selected:
        claude_root = client_config_root("claude")
        roots.append((claude_root / "skills", claude_root))
    unique: dict[str, tuple[Path, Path]] = {}
    for skills_root, trusted_root in roots:
        absolute_root = Path(os.path.abspath(skills_root))
        absolute_boundary = Path(os.path.abspath(trusted_root))
        unique[str(absolute_root)] = (absolute_root, absolute_boundary)
    return list(unique.values())


def previous_skill_ownership(
    bundle: dict[str, Any],
    receipt: dict[str, Any] | None,
    roots: list[tuple[Path, Path]],
    *,
    bundle_name: str = "matt-pocock-skills",
) -> dict[str, set[str]]:
    ownership = {str(root): set() for root, _ in roots}
    if not receipt or bundle_name not in receipt.get("bundles", []):
        return ownership
    if receipt.get("schemaVersion") == 2:
        resolved = receipt.get("resolved", {}).get(bundle_name, {})
        skills = resolved.get("skills") if isinstance(resolved, dict) else None
        targets = resolved.get("targets") if isinstance(resolved, dict) else None
        if isinstance(skills, dict) and isinstance(targets, list):
            names = {name for name in skills if isinstance(name, str)}
            recorded = {str(Path(os.path.abspath(path))) for path in targets if isinstance(path, str)}
            pending = resolved.get("ownedByTarget") if resolved.get("status") == "pending" else None
            for root, _ in roots:
                if str(root) in recorded:
                    pending_names = pending.get(str(root)) if isinstance(pending, dict) else None
                    ownership[str(root)] = (
                        {name for name in pending_names if isinstance(name, str)}
                        if isinstance(pending_names, list)
                        else set(names)
                    )
        return ownership

    checkout = STATE_DIR / "sources" / bundle_name
    if checkout_problem(checkout, bundle["repository"]):
        return ownership
    try:
        names = set(discover_skill_package(checkout, bundle, bundle_name=bundle_name))
    except UpstreamError:
        return ownership
    prior_clients = receipt.get("clients", [])
    prior_roots = {str(root) for root, _ in skill_destination_roots(prior_clients)}
    for root, _ in roots:
        if str(root) in prior_roots:
            ownership[str(root)] = set(names)
    return ownership


def archive_stale_skill(destination: Path, backup: Path, trusted_root: Path) -> None:
    validate_skill_destination(destination, trusted_root)
    if not destination.exists():
        return
    if not destination.is_dir():
        raise UpstreamError(f"Refusing non-directory managed skill destination: {destination}")
    backup.parent.mkdir(parents=True, exist_ok=True)
    if backup.exists() or backup.is_symlink():
        raise UpstreamError(f"Refusing existing retired skill backup: {backup}")
    print(f"+ archive skill removed upstream: {destination} -> {backup}")
    shutil.move(str(destination), str(backup))


def preflight_skill_changes(
    roots: list[tuple[Path, Path]],
    ownership: dict[str, set[str]],
    current_names: set[str],
    *,
    adopt_existing: bool,
) -> None:
    for root, trusted_root in roots:
        managed_names = ownership[str(root)]
        for name in sorted(managed_names | current_names):
            destination = root / name
            validate_skill_destination(destination, trusted_root)
            if not destination.exists():
                continue
            if not destination.is_dir():
                raise UpstreamError(f"Refusing non-directory skill destination: {destination}")
            if name in current_names and name not in managed_names and not adopt_existing:
                raise UpstreamError(
                    f"Refusing unmanaged skill at {destination}. "
                    "Re-run with --adopt-existing to preserve and explicitly replace it."
                )


def install_skills_package(
    bundle: dict[str, Any],
    clients: list[str],
    dry_run: bool,
    receipt: dict[str, Any] | None,
    *,
    adopt_existing: bool,
    profile: str,
    bundle_name: str = "matt-pocock-skills",
) -> dict[str, Any]:
    display_name = bundle.get("displayName", bundle_name)
    selected = clients_for(bundle, clients)
    if not selected:
        return {}
    prior_clients = (receipt or {}).get("clients", [])
    managed_clients = list(
        dict.fromkeys(
            selected
            + [
                client
                for client in prior_clients
                if client in {"codex", "claude"} and client in bundle.get("clients", [])
            ]
        )
    )
    roots = skill_destination_roots(managed_clients)
    ownership = (
        previous_skill_ownership(bundle, receipt, roots, bundle_name=bundle_name)
        if not dry_run
        else {}
    )
    checkout = ensure_tracked_skills_checkout(bundle, dry_run, bundle_name=bundle_name)
    if dry_run:
        selection = "the allowlisted" if bundle.get("skills") else "every discovered"
        print(f"+ validate and copy {selection} skill from {display_name}")
        return {
            "repository": bundle["repository"],
            "ref": bundle.get("ref", "main"),
            "commit": "resolved-at-install",
            "skills": {},
            "targets": [],
        }
    skills = discover_skill_package(checkout, bundle, bundle_name=bundle_name)
    commit = git_value(checkout, "rev-parse", "HEAD")
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise UpstreamError(f"{display_name} checkout did not resolve to an exact Git commit")
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    backup_root = STATE_DIR / "backups" / bundle_name / stamp
    current_names = set(skills)
    preflight_skill_changes(
        roots,
        ownership,
        current_names,
        adopt_existing=adopt_existing,
    )
    pending_ownership = {
        str(root): sorted(ownership[str(root)] | current_names) for root, _ in roots
    }
    save_receipt(
        profile,
        managed_clients,
        [bundle_name],
        {
            bundle_name: {
                "repository": bundle["repository"],
                "ref": bundle.get("ref", "main"),
                "commit": commit,
                "skills": skills,
                "targets": [str(root) for root, _ in roots],
                "status": "pending",
                "ownedByTarget": pending_ownership,
            }
        },
    )
    for index, (root, trusted_root) in enumerate(roots, start=1):
        for stale in sorted(ownership[str(root)] - current_names):
            archive_stale_skill(
                root / stale,
                backup_root / f"target-{index}" / "retired" / stale,
                trusted_root,
            )
    for name, relative in skills.items():
        source = checkout / relative
        for index, (root, trusted_root) in enumerate(roots, start=1):
            backup_and_copy_skill(
                source,
                root / name,
                backup_root / f"target-{index}" / "replaced",
                trusted_root,
                managed=name in ownership[str(root)],
                adopt_existing=adopt_existing,
            )
    print(
        f"= installed {len(skills)} {display_name} skill(s) from {commit[:12]} for "
        + ", ".join(selected)
    )
    return {
        "repository": bundle["repository"],
        "ref": bundle.get("ref", "main"),
        "commit": commit,
        "skills": skills,
        "targets": [str(root) for root, _ in roots],
        "status": "active",
    }


def skill_tree_manifest(path: Path) -> dict[str, tuple[str, str]]:
    if path.is_symlink() or not path.is_dir():
        raise UpstreamError(f"skill directory is missing or symlinked: {path}")
    manifest: dict[str, tuple[str, str]] = {}
    for current, directories, files in os.walk(path, followlinks=False):
        current_path = Path(current)
        for name in sorted(directories):
            candidate = current_path / name
            relative = candidate.relative_to(path).as_posix()
            if candidate.is_symlink() or not candidate.is_dir():
                raise UpstreamError(f"skill tree contains an unsafe directory: {relative}")
            manifest[relative] = ("directory", "")
        for name in sorted(files):
            candidate = current_path / name
            relative = candidate.relative_to(path).as_posix()
            if candidate.is_symlink() or not candidate.is_file():
                raise UpstreamError(f"skill tree contains an unsafe file: {relative}")
            manifest[relative] = ("file", hashlib.sha256(candidate.read_bytes()).hexdigest())
    return manifest


def skill_tree_problem(source: Path, installed: Path) -> str | None:
    try:
        expected = skill_tree_manifest(source)
        observed = skill_tree_manifest(installed)
    except UpstreamError as exc:
        return str(exc)
    if expected == observed:
        return None
    missing = sorted(set(expected) - set(observed))
    extra = sorted(set(observed) - set(expected))
    changed = sorted(
        name for name in set(expected) & set(observed) if expected[name] != observed[name]
    )
    details = []
    if missing:
        details.append("missing " + ", ".join(missing[:3]))
    if extra:
        details.append("extra " + ", ".join(extra[:3]))
    if changed:
        details.append("changed " + ", ".join(changed[:3]))
    return "; ".join(details) or "skill trees differ"


def doctor_skills_package(
    bundle: dict[str, Any],
    clients: list[str],
    receipt: dict[str, Any] | None,
    *,
    bundle_name: str = "matt-pocock-skills",
) -> int:
    display_name = bundle.get("displayName", bundle_name)
    resolved = (receipt or {}).get("resolved", {}).get(bundle_name)
    if not isinstance(resolved, dict):
        print(f"FAIL upstream {display_name}: install receipt is outdated; run update")
        return 1
    if resolved.get("status") == "pending":
        print(f"FAIL upstream {display_name}: interrupted refresh is pending; run update")
        return 1
    commit = resolved.get("commit")
    expected = resolved.get("skills")
    targets = resolved.get("targets")
    if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}", commit):
        print(f"FAIL upstream {display_name}: receipt has no exact source commit")
        return 1
    if not isinstance(expected, dict) or not expected or not all(
        isinstance(name, str) and isinstance(relative, str)
        for name, relative in expected.items()
    ):
        print(f"FAIL upstream {display_name}: receipt has no valid skill inventory")
        return 1
    if not isinstance(targets, list) or not all(isinstance(path, str) for path in targets):
        print(f"FAIL upstream {display_name}: receipt has no valid managed targets")
        return 1
    required_targets = {
        str(root) for root, _ in skill_destination_roots(clients_for(bundle, clients))
    }
    if not required_targets.issubset(set(targets)):
        print(f"FAIL upstream {display_name}: selected client target is not receipted")
        return 1
    if resolved.get("repository") != bundle["repository"] or resolved.get("ref") != bundle.get(
        "ref", "main"
    ):
        print(f"FAIL upstream {display_name}: receipt source identity does not match catalog")
        return 1
    checkout = STATE_DIR / "sources" / bundle_name
    problem = checkout_problem(
        checkout, bundle["repository"], expected_commit=commit
    )
    if problem:
        print(f"FAIL upstream {display_name} source: {problem}")
        return 1
    try:
        discovered = discover_skill_package(checkout, bundle, bundle_name=bundle_name)
    except UpstreamError as exc:
        print(f"FAIL upstream {display_name} source: {exc}")
        return 1
    if discovered != expected:
        print(f"FAIL upstream {display_name}: receipted inventory is not complete for its source commit")
        return 1
    failures = 0
    canonical = Path.home() / ".agents" / "skills"
    client_roots = {
        "codex": canonical,
        "claude": client_config_root("claude") / "skills",
    }
    for name, relative in expected.items():
        source = checkout / relative
        installed = canonical / name
        source_problem = skill_tree_problem(source, installed)
        if source_problem:
            print(f"FAIL upstream {display_name} skill source: {name} ({source_problem})")
            failures += 1
            continue
        for client in clients_for(bundle, clients):
            discovered = client_roots[client] / name
            discovery_problem = skill_tree_problem(source, discovered)
            if discovery_problem:
                print(
                    f"FAIL upstream {display_name} skill discovery: {name} ({client}: {discovery_problem})"
                )
                failures += 1
    if not failures:
        print(
            f"PASS upstream {display_name}: {len(expected)} skill(s) from "
            f"{commit[:12]} discovered by {', '.join(clients)}"
        )
    return failures


def marketplace_entries(client: str) -> list[dict[str, Any]]:
    if client == "codex":
        data = run_json(["codex", "plugin", "marketplace", "list", "--json"])
        return data.get("marketplaces", []) if isinstance(data, dict) else []
    data = run_json(["claude", "plugin", "marketplace", "list", "--json"])
    return data if isinstance(data, list) else []


def marketplace_entry(client: str, name: str) -> dict[str, Any] | None:
    return next((entry for entry in marketplace_entries(client) if entry.get("name") == name), None)


def marketplace_repo(client: str, entry: dict[str, Any]) -> str | None:
    if client == "codex":
        return normalize_repo(str(entry.get("marketplaceSource", {}).get("source", "")))
    return normalize_repo(str(entry.get("repo", "")))


def ensure_marketplace(bundle: dict[str, Any], client: str, dry_run: bool) -> None:
    name = bundle["marketplace"]
    entry = marketplace_entry(client, name)
    expected = normalize_repo(bundle["repository"])
    if entry:
        actual = marketplace_repo(client, entry)
        if actual != expected:
            raise UpstreamError(
                f"Refusing conflicting {name} marketplace for {client}: expected {expected}, found {actual or 'unknown'}"
            )
        print(f"= trusted upstream marketplace already registered: {name} ({client})")
        return
    command = [client, "plugin", "marketplace", "add", bundle["repository"]]
    if client == "codex" and bundle.get("ref"):
        command += ["--ref", bundle["ref"]]
    command += ["--json"] if client == "codex" else ["--scope", "user"]
    run(command, dry_run=dry_run)
    if not dry_run:
        registered = marketplace_entry(client, name)
        actual = marketplace_repo(client, registered or {})
        if actual != expected:
            raise UpstreamError(
                f"Marketplace source verification failed for {name} ({client}): {actual or 'unknown'}"
            )


def plugin_entries(client: str) -> list[dict[str, Any]]:
    if client == "codex":
        data = run_json(["codex", "plugin", "list", "--available", "--json"])
    else:
        data = run_json(["claude", "plugin", "list", "--available", "--json"])
    if isinstance(data, list):
        return data
    if not isinstance(data, dict):
        return []
    return [*data.get("installed", []), *data.get("available", [])]


def plugin_is_installed(client: str, selector: str) -> bool:
    for entry in plugin_entries(client):
        identifier = entry.get("pluginId") if client == "codex" else entry.get("id")
        installed = entry.get("installed", True)
        enabled = entry.get("enabled", True)
        if identifier == selector and installed and enabled:
            return True
    return False


def install_marketplace_bundle(
    bundle: dict[str, Any], clients: list[str], dry_run: bool, *, update: bool
) -> None:
    for client in clients_for(bundle, clients):
        ensure_marketplace(bundle, client, dry_run)
        if update and not dry_run:
            entry = marketplace_entry(client, bundle["marketplace"])
            actual = marketplace_repo(client, entry or {})
            if actual:
                command = (
                    ["codex", "plugin", "marketplace", "upgrade", bundle["marketplace"], "--json"]
                    if client == "codex"
                    else ["claude", "plugin", "marketplace", "update", bundle["marketplace"]]
                )
                run(command)
                refreshed = marketplace_entry(client, bundle["marketplace"])
                if marketplace_repo(client, refreshed or {}) != normalize_repo(bundle["repository"]):
                    raise UpstreamError(
                        f"Marketplace source changed unexpectedly during update: {bundle['marketplace']} ({client})"
                    )
        for plugin in bundle["plugins"]:
            if plugin == "build-macos-apps" and platform.system() != "Darwin":
                print(f"= skip macOS-only upstream plugin on {platform.system()}: {plugin}")
                continue
            selector = f"{plugin}@{bundle['marketplace']}"
            installed = False if dry_run else plugin_is_installed(client, selector)
            if update and client == "codex":
                run(["codex", "plugin", "add", selector, "--json"], dry_run=dry_run)
            elif update and installed and client == "claude":
                run(["claude", "plugin", "update", selector, "--scope", "user"], dry_run=dry_run)
            elif not installed:
                command = (
                    ["codex", "plugin", "add", selector, "--json"]
                    if client == "codex"
                    else ["claude", "plugin", "install", selector, "--scope", "user"]
                )
                run(command, dry_run=dry_run)
            else:
                print(f"= upstream plugin already installed: {selector} ({client})")


def doctor_marketplace_bundle(bundle: dict[str, Any], clients: list[str]) -> int:
    failures = 0
    for client in clients_for(bundle, clients):
        try:
            entry = marketplace_entry(client, bundle["marketplace"])
        except UpstreamError as exc:
            print(f"FAIL upstream marketplace {bundle['marketplace']} ({client}): {exc}")
            failures += 1
            continue
        expected = normalize_repo(bundle["repository"])
        actual = marketplace_repo(client, entry or {})
        healthy_marketplace = entry is not None and actual == expected
        print(
            f"{'PASS' if healthy_marketplace else 'FAIL'} upstream marketplace: "
            f"{bundle['marketplace']} ({client})"
            + ("" if healthy_marketplace else f"; expected {expected}, found {actual or 'unknown'}")
        )
        failures += 0 if healthy_marketplace else 1
        if not healthy_marketplace:
            continue
        for plugin in bundle["plugins"]:
            if plugin == "build-macos-apps" and platform.system() != "Darwin":
                continue
            selector = f"{plugin}@{bundle['marketplace']}"
            healthy = plugin_is_installed(client, selector)
            print(f"{'PASS' if healthy else 'FAIL'} upstream plugin: {selector} ({client})")
            failures += 0 if healthy else 1
    return failures


def git_checkout_matches(path: Path, repository: str) -> bool:
    completed = subprocess.run(
        ["git", "-C", str(path), "remote", "get-url", "origin"],
        check=False,
        text=True,
        capture_output=True,
    )
    return completed.returncode == 0 and normalize_repo(completed.stdout.strip()) == normalize_repo(repository)


def write_openai_adapter(bundle: dict[str, Any], adapter: Path) -> None:
    plugins = []
    for name in bundle["plugins"]:
        if name == "build-macos-apps" and platform.system() != "Darwin":
            continue
        source = adapter / "upstream" / "plugins" / name
        if not (source / ".codex-plugin" / "plugin.json").is_file():
            raise UpstreamError(f"Official OpenAI source is missing the expected plugin: {name}")
        plugins.append(
            {
                "name": name,
                "source": {"source": "local", "path": f"./upstream/plugins/{name}"},
                "policy": {"installation": "AVAILABLE", "authentication": "ON_INSTALL"},
                "category": "Developer Tools",
            }
        )
    payload = {
        "name": bundle["fallbackMarketplace"],
        "interface": {"displayName": "OpenAI essentials via Agent Toolkit"},
        "plugins": plugins,
    }
    manifest_dir = adapter / ".agents" / "plugins"
    ensure_private_directory(manifest_dir)
    target = manifest_dir / "marketplace.json"
    temporary = target.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    if os.name != "nt":
        os.chmod(temporary, 0o600)
    os.replace(temporary, target)


def ensure_openai_adapter(bundle: dict[str, Any], dry_run: bool, *, update: bool) -> str:
    git = shutil.which("git")
    if not git:
        raise UpstreamError("The OpenAI essentials fallback adapter requires Git on PATH.")
    name = bundle["fallbackMarketplace"]
    adapter = STATE_DIR / "marketplaces" / name
    upstream = adapter / "upstream"
    repository = bundle["repository"]
    ref = bundle.get("ref", "main")
    if adapter.is_symlink() or upstream.is_symlink():
        raise UpstreamError(f"Refusing symlinked OpenAI adapter state: {adapter}")
    existing = marketplace_entry("codex", name)
    if existing:
        actual_root = existing.get("root") or existing.get("marketplaceSource", {}).get("source")
        if not actual_root or Path(str(actual_root)).resolve() != adapter.resolve():
            raise UpstreamError(f"Refusing conflicting {name} Codex marketplace")
    if not upstream.exists():
        if not dry_run:
            ensure_private_directory(adapter)
        run(
            [git, "clone", "--depth", "1", "--branch", ref, f"https://github.com/{repository}.git", str(upstream)],
            dry_run=dry_run,
        )
        if not dry_run and not git_checkout_matches(upstream, repository):
            raise UpstreamError(f"Refusing unexpected Git source at {upstream}")
    elif not git_checkout_matches(upstream, repository):
        raise UpstreamError(f"Refusing unexpected Git source at {upstream}")
    if not dry_run:
        problem = checkout_problem(upstream, repository)
        if problem:
            raise UpstreamError(f"Refusing unverified OpenAI source checkout: {problem}")
    if update and upstream.exists():
        shallow = run(
            [git, "-C", str(upstream), "rev-parse", "--is-shallow-repository"], capture=True
        )
        assert shallow is not None
        fetch = [git, "-C", str(upstream), "fetch"]
        if shallow.stdout.strip() == "true":
            fetch.append("--unshallow")
        fetch += ["origin", ref]
        run(fetch, dry_run=dry_run)
        run([git, "-C", str(upstream), "merge", "--ff-only", "FETCH_HEAD"], dry_run=dry_run)
    if not dry_run:
        problem = checkout_problem(upstream, repository, tracking_ref=ref)
        if problem:
            raise UpstreamError(f"OpenAI source checkout does not exactly match its tracked source: {problem}")
    if dry_run:
        print(f"+ generate local {name} adapter from the verified official checkout")
    else:
        write_openai_adapter(bundle, adapter)
    if not existing:
        run(["codex", "plugin", "marketplace", "add", str(adapter), "--json"], dry_run=dry_run)
    return name


def official_codex_marketplace_trusted(bundle: dict[str, Any], entry: dict[str, Any]) -> bool:
    actual = marketplace_repo("codex", entry)
    expected = normalize_repo(bundle["repository"])
    if actual is not None:
        return actual == expected
    if not bundle.get("runtimeReserved"):
        return False
    available = {
        item.get("pluginId")
        for item in plugin_entries("codex")
        if isinstance(item.get("pluginId"), str)
    }
    required = {
        f"{name}@{bundle['marketplace']}"
        for name in bundle["plugins"]
        if name != "build-macos-apps" or platform.system() == "Darwin"
    }
    return required <= available


def install_codex_official_bundle(
    bundle: dict[str, Any], clients: list[str], dry_run: bool, *, update: bool
) -> None:
    if "codex" not in clients_for(bundle, clients):
        return
    official = marketplace_entry("codex", bundle["marketplace"])
    if official:
        if not official_codex_marketplace_trusted(bundle, official):
            raise UpstreamError(
                f"Refusing unverifiable reserved {bundle['marketplace']} marketplace; expected official OpenAI package identities"
            )
        name = bundle["marketplace"]
        print(f"= use Codex-provided official marketplace: {name}")
    else:
        name = ensure_openai_adapter(bundle, dry_run, update=update)
        print(f"= Codex official marketplace is runtime-managed; use verified local adapter: {name}")
    for plugin in bundle["plugins"]:
        if plugin == "build-macos-apps" and platform.system() != "Darwin":
            print(f"= skip macOS-only upstream plugin on {platform.system()}: {plugin}")
            continue
        selector = f"{plugin}@{name}"
        installed = False if dry_run else plugin_is_installed("codex", selector)
        if update or not installed:
            run(["codex", "plugin", "add", selector, "--json"], dry_run=dry_run)
        else:
            print(f"= upstream plugin already installed: {selector} (codex)")


def doctor_codex_official_bundle(bundle: dict[str, Any], clients: list[str]) -> int:
    if "codex" not in clients_for(bundle, clients):
        return 0
    official = marketplace_entry("codex", bundle["marketplace"])
    if official and not official_codex_marketplace_trusted(bundle, official):
        print("FAIL upstream OpenAI essentials marketplace: reserved catalog identity is not verifiable")
        return 1
    name = bundle["marketplace"] if official else bundle["fallbackMarketplace"]
    fallback = marketplace_entry("codex", name) if not official else official
    if not fallback:
        print("FAIL upstream OpenAI essentials marketplace: no official runtime catalog or verified adapter")
        return 1
    failures = 0
    if not official:
        adapter = STATE_DIR / "marketplaces" / bundle["fallbackMarketplace"]
        actual_root = fallback.get("root") or fallback.get("marketplaceSource", {}).get("source")
        checkout = adapter / "upstream"
        problem = checkout_problem(checkout, bundle["repository"], tracking_ref=bundle.get("ref", "main"))
        if not actual_root or Path(str(actual_root)).resolve() != adapter.resolve() or problem:
            print(
                "FAIL upstream OpenAI essentials marketplace: fallback adapter root or checkout is not exact"
                + (f" ({problem})" if problem else "")
            )
            return 1
    print(f"PASS upstream OpenAI essentials marketplace: {name} (codex)")
    for plugin in bundle["plugins"]:
        if plugin == "build-macos-apps" and platform.system() != "Darwin":
            continue
        selector = f"{plugin}@{name}"
        healthy = plugin_is_installed("codex", selector)
        print(f"{'PASS' if healthy else 'FAIL'} upstream plugin: {selector} (codex)")
        failures += 0 if healthy else 1
    return failures


def platform_key() -> str:
    systems = {"Darwin": "macos", "Linux": "linux", "Windows": "windows"}
    machines = {"arm64": "aarch64", "aarch64": "aarch64", "x86_64": "x86_64", "AMD64": "x86_64"}
    system = systems.get(platform.system())
    machine = machines.get(platform.machine())
    if not system or not machine:
        raise UpstreamError(f"Obscura has no allowlisted build for {platform.system()} {platform.machine()}")
    return f"{system}-{machine}"


def safe_extract_tar(archive: Path, destination: Path) -> None:
    with tarfile.open(archive) as handle:
        for member in handle.getmembers():
            target = (destination / member.name).resolve()
            if (
                destination.resolve() not in (target, *target.parents)
                or member.issym()
                or member.islnk()
                or not (member.isfile() or member.isdir())
            ):
                raise UpstreamError(f"Unsafe path in Obscura archive: {member.name}")
        handle.extractall(destination)


def safe_extract_zip(archive: Path, destination: Path) -> None:
    with zipfile.ZipFile(archive) as handle:
        for member in handle.infolist():
            target = (destination / member.filename).resolve()
            mode = member.external_attr >> 16
            if destination.resolve() not in (target, *target.parents) or stat.S_ISLNK(mode):
                raise UpstreamError(f"Unsafe path in Obscura archive: {member.filename}")
        handle.extractall(destination)


def obscura_expected_binary(bundle: dict[str, Any]) -> Path:
    version = bundle["version"]
    destination = STATE_DIR / "tools" / "obscura" / version
    return destination / ("obscura.exe" if os.name == "nt" else "obscura")


def obscura_expected_worker(bundle: dict[str, Any]) -> Path:
    executable = obscura_expected_binary(bundle)
    return executable.parent / ("obscura-worker.exe" if os.name == "nt" else "obscura-worker")


def file_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def verify_obscura_payload(bundle: dict[str, Any], asset: dict[str, Any]) -> tuple[Path, Path]:
    executable = obscura_expected_binary(bundle)
    worker = obscura_expected_worker(bundle)
    if executable.is_symlink() or worker.is_symlink():
        raise UpstreamError("Refusing symlinked Obscura managed payload")
    if not executable.is_file() or not worker.is_file():
        raise UpstreamError(f"Obscura payload is incomplete at the managed path: {executable.parent}")
    observed_binary = file_sha256(executable)
    observed_worker = file_sha256(worker)
    if observed_binary != asset["binarySha256"] or observed_worker != asset["workerSha256"]:
        raise UpstreamError("Obscura managed executable checksum does not match the allowlist")
    return executable, worker


def obscura_binary(bundle: dict[str, Any], dry_run: bool) -> Path:
    version = bundle["version"]
    key = platform_key()
    asset = bundle["assets"].get(key)
    if not asset:
        raise UpstreamError(f"Obscura has no allowlisted asset for {key}")
    executable = obscura_expected_binary(bundle)
    worker = obscura_expected_worker(bundle)
    destination = executable.parent
    if executable.is_file():
        verify_obscura_payload(bundle, asset)
        return executable
    print(f"+ download verified Obscura {version} for {key}")
    if dry_run:
        return executable
    ensure_private_directory(destination)
    url = f"https://github.com/{bundle['repository']}/releases/download/v{version}/{asset['name']}"
    with tempfile.TemporaryDirectory(prefix="agent-toolkit-obscura-") as temporary:
        root = Path(temporary)
        archive = root / asset["name"]
        urllib.request.urlretrieve(url, archive)
        digest = hashlib.sha256(archive.read_bytes()).hexdigest()
        if digest != asset["sha256"]:
            raise UpstreamError(f"Obscura checksum mismatch: expected {asset['sha256']}, found {digest}")
        extracted = root / "extracted"
        extracted.mkdir()
        if archive.suffix == ".zip":
            safe_extract_zip(archive, extracted)
        else:
            safe_extract_tar(archive, extracted)
        name = "obscura.exe" if os.name == "nt" else "obscura"
        worker_name = "obscura-worker.exe" if os.name == "nt" else "obscura-worker"
        candidates = list(extracted.rglob(name))
        worker_candidates = list(extracted.rglob(worker_name))
        if len(candidates) != 1 or len(worker_candidates) != 1:
            raise UpstreamError(f"Expected one {name} and one {worker_name} in the verified Obscura archive")
        if file_sha256(candidates[0]) != asset["binarySha256"]:
            raise UpstreamError("Obscura executable checksum mismatch after extraction")
        if file_sha256(worker_candidates[0]) != asset["workerSha256"]:
            raise UpstreamError("Obscura worker checksum mismatch after extraction")
        shutil.copy2(candidates[0], executable)
        shutil.copy2(worker_candidates[0], worker)
        if os.name != "nt":
            executable.chmod(executable.stat().st_mode | stat.S_IXUSR)
            worker.chmod(worker.stat().st_mode | stat.S_IXUSR)
    verify_obscura_payload(bundle, asset)
    return executable


def mcp_registration(client: str) -> subprocess.CompletedProcess[str]:
    command = ["codex", "mcp", "get", "obscura", "--json"] if client == "codex" else [
        "claude",
        "mcp",
        "get",
        "obscura",
    ]
    completed = subprocess.run(command, check=False, text=True, capture_output=True)
    return completed


def mcp_registration_spec(client: str) -> tuple[str, list[str]] | None:
    completed = mcp_registration(client)
    text = (completed.stdout + completed.stderr).strip()
    if completed.returncode != 0:
        lowered = text.lower()
        if any(marker in lowered for marker in ("not found", "does not exist", "no mcp server")):
            return None
        raise UpstreamError(f"Unable to inspect existing Obscura MCP registration for {client}: {text or 'unknown error'}")
    if client == "codex":
        try:
            data = json.loads(completed.stdout)
        except json.JSONDecodeError as exc:
            raise UpstreamError("Codex returned invalid JSON for the Obscura MCP registration") from exc
        transport = data.get("transport", {}) if isinstance(data, dict) else {}
        command = transport.get("command")
        arguments = transport.get("args")
        if not isinstance(command, str) or not isinstance(arguments, list) or not all(
            isinstance(item, str) for item in arguments
        ):
            raise UpstreamError("Codex Obscura MCP registration has an unsupported shape")
        return command, arguments
    command_match = re.search(r"^\s*Command:\s*(.+?)\s*$", completed.stdout, re.MULTILINE)
    args_match = re.search(r"^\s*Args:\s*(.*?)\s*$", completed.stdout, re.MULTILINE)
    if not command_match or not args_match:
        raise UpstreamError("Claude Obscura MCP registration has an unsupported shape")
    return command_match.group(1), args_match.group(1).split()


def mcp_spec_matches(spec: tuple[str, list[str]], executable: Path) -> bool:
    command, arguments = spec
    return Path(command).expanduser().resolve() == executable.resolve() and arguments == ["mcp"]


def install_obscura(bundle: dict[str, Any], clients: list[str], dry_run: bool, *, update: bool) -> None:
    executable = obscura_binary(bundle, dry_run)
    managed_root = (STATE_DIR / "tools" / "obscura").resolve()
    for client in clients_for(bundle, clients):
        existing = None if dry_run else mcp_registration_spec(client)
        if existing:
            if mcp_spec_matches(existing, executable):
                print(f"= verified existing Obscura MCP registration ({client})")
                continue
            command_path = Path(existing[0]).expanduser().resolve()
            managed = managed_root in (command_path, *command_path.parents) and existing[1] == ["mcp"]
            if update and managed:
                remove = ["codex", "mcp", "remove", "obscura"] if client == "codex" else [
                    "claude",
                    "mcp",
                    "remove",
                    "obscura",
                    "--scope",
                    "user",
                ]
                run(remove)
            else:
                raise UpstreamError(
                    f"Refusing conflicting Obscura MCP registration for {client}: {existing[0]} {' '.join(existing[1])}"
                )
        command = ["codex", "mcp", "add", "obscura", "--", str(executable), "mcp"] if client == "codex" else [
            "claude",
            "mcp",
            "add",
            "obscura",
            "--scope",
            "user",
            "--",
            str(executable),
            "mcp",
        ]
        run(command, dry_run=dry_run)


def doctor_obscura(bundle: dict[str, Any], clients: list[str]) -> int:
    failures = 0
    try:
        executable = obscura_expected_binary(bundle)
        asset = bundle.get("assets", {}).get(platform_key())
        if not asset:
            raise UpstreamError("Obscura has no allowlisted asset for this platform")
        verify_obscura_payload(bundle, asset)
        version = run([str(executable), "--version"], capture=True)
        assert version is not None
        observed = (version.stdout or version.stderr).strip()
        if bundle["version"] not in observed:
            raise UpstreamError(f"expected version {bundle['version']}, found {observed or 'unknown'}")
        print(f"PASS upstream Obscura: {observed}; executable and worker checksums verified")
    except UpstreamError as exc:
        print(f"FAIL upstream Obscura: {exc}")
        return 1
    for client in clients_for(bundle, clients):
        try:
            spec = mcp_registration_spec(client)
            healthy = spec is not None and mcp_spec_matches(spec, executable)
        except UpstreamError:
            healthy = False
        print(f"{'PASS' if healthy else 'FAIL'} upstream Obscura MCP: {client}")
        failures += 0 if healthy else 1
    return failures


def process_bundle(
    name: str,
    bundle: dict[str, Any],
    command: str,
    clients: list[str],
    profile: str,
    dry_run: bool,
    receipt: dict[str, Any] | None,
    adopt_existing: bool,
) -> tuple[int, dict[str, Any] | None]:
    print(f"\n== {bundle['displayName']} ==")
    if command == "doctor":
        if bundle["kind"] == "graphify":
            return doctor_graphify(bundle, clients, receipt), None
        if bundle["kind"] == "skills-package":
            return doctor_skills_package(
                bundle, clients, receipt, bundle_name=name
            ), None
        if bundle["kind"] == "marketplace":
            return doctor_marketplace_bundle(bundle, clients), None
        if bundle["kind"] == "codex-official":
            return doctor_codex_official_bundle(bundle, clients), None
        if bundle["kind"] == "obscura":
            return doctor_obscura(bundle, clients), None
    update = command == "update"
    resolved = None
    if bundle["kind"] == "graphify":
        resolved = install_graphify(
            bundle,
            clients,
            dry_run,
            receipt,
            adopt_existing=adopt_existing,
            profile=profile,
        )
    elif bundle["kind"] == "skills-package":
        resolved = install_skills_package(
            bundle,
            clients,
            dry_run,
            receipt,
            adopt_existing=adopt_existing,
            profile=profile,
            bundle_name=name,
        )
    elif bundle["kind"] == "marketplace":
        install_marketplace_bundle(bundle, clients, dry_run, update=update)
    elif bundle["kind"] == "codex-official":
        install_codex_official_bundle(bundle, clients, dry_run, update=update)
    elif bundle["kind"] == "obscura":
        install_obscura(bundle, clients, dry_run, update=update)
    else:
        raise UpstreamError(f"Unsupported upstream kind for {name}: {bundle.get('kind')}")
    return 0, resolved


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agent-upstreams", description=__doc__)
    parser.add_argument("command", choices=("install", "update", "doctor"))
    parser.add_argument("--profile", choices=("recommended", "skills-only", "full"), required=True)
    parser.add_argument("--clients", required=True, help="comma-separated codex,claude list")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "--adopt-existing",
        action="store_true",
        help="preserve and replace conflicting untracked skill directories explicitly",
    )
    return parser


def main() -> int:
    try:
        args = build_parser().parse_args()
        clients = selected_clients(args.clients)
        names = profile_bundles(args.profile)
        catalog = catalog_bundles()
        unknown = [name for name in names if name not in catalog]
        if unknown:
            raise UpstreamError("Profile references unknown upstream bundles: " + ", ".join(unknown))
        receipt = load_receipt()
        outcomes = []
        for name in names:
            outcome = process_bundle(
                name,
                catalog[name],
                args.command,
                clients,
                args.profile,
                args.dry_run,
                receipt,
                args.adopt_existing,
            )
            outcomes.append((name, outcome))
            if args.command != "doctor" and not args.dry_run:
                resolved = {name: outcome[1]} if isinstance(outcome[1], dict) and outcome[1] else {}
                save_receipt(args.profile, clients, [name], resolved)
                receipt = load_receipt()
        failures = sum(outcome[0] for _, outcome in outcomes)
        if failures:
            raise UpstreamError(f"Upstream doctor found {failures} missing or disabled component(s)")
        if args.command == "doctor":
            print("\nUpstream doctor passed.")
        else:
            print("\nUpstream setup complete. Provider authentication remains per user and happens on use.")
        return 0
    except UpstreamError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
